 		  const char *__new, unsigned int __flags)
 {
 	if (__flags != 0) {
+#if defined(__APPLE__) && defined(RENAME_EXCL)
+		/*
+		 * macOS has no renameat2 but renameatx_np(RENAME_EXCL) is the same
