+// AnyOS: mesh workload groups.
+llvm::Value *
+Converter::HullPackWorkloadGroups(
+    llvm::Value *DataPtr, llvm::Value *Count, llvm::Value *MaxVertices, llvm::Value *MaxPrimitives,
+    llvm::Value *GroupStartPtr
+) {
+  using namespace llvm;
+  auto &Context = air.getContext();
+  auto Attrs = AttributeList::get(
+      Context, {{~0U, Attribute::get(Context, Attribute::AttrKind::NoUnwind)},
+                {~0U, Attribute::get(Context, Attribute::AttrKind::WillReturn)}}
+  );
+  SmallVector<Value *> Ops{DataPtr, Count, MaxVertices, MaxPrimitives, GroupStartPtr};
+  SmallVector<Type *> Tys{DataPtr->getType(), Count->getType(), MaxVertices->getType(), MaxPrimitives->getType(),
+                          GroupStartPtr->getType()};
+  auto Fn = air.getModule()->getOrInsertFunction(
+      "dxmt.pack_workload_groups", llvm::FunctionType::get(air.getIntTy(), Tys, false), Attrs
+  );
+  return ir.CreateCall(Fn, Ops);
+}
+
+llvm::Value *
+Converter::DomainLocateGroupVertex(llvm::Value *First, llvm::Value *Last, llvm::Value *Vertex, llvm::Value *DataPtr) {
+  using namespace llvm;
+  auto &Context = air.getContext();
+  auto Attrs = AttributeList::get(
+      Context, {{4U, Attribute::get(Context, Attribute::AttrKind::ReadOnly)},
+                {4U, Attribute::get(Context, Attribute::AttrKind::NoCapture)},
+                {~0U, Attribute::get(Context, Attribute::AttrKind::NoUnwind)},
+                {~0U, Attribute::get(Context, Attribute::AttrKind::WillReturn)},
+                {~0U, Attribute::get(Context, Attribute::AttrKind::ReadOnly)}}
+  );
+  SmallVector<Value *> Ops{First, Last, Vertex, DataPtr};
+  SmallVector<Type *> Tys{First->getType(), Last->getType(), Vertex->getType(), DataPtr->getType()};
+  auto Fn = air.getModule()->getOrInsertFunction(
+      "dxmt.locate_group_vertex", llvm::FunctionType::get(air.getIntTy(), Tys, false), Attrs
+  );
+  return ir.CreateCall(Fn, Ops);
+}
