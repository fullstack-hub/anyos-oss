+  uint count = workload_vertex_count(workload);
+  uint base;
+  bool ok;
+  stream_indices(indices, counters, count, base, ok);
+  if (!ok)
+    return;
+  for (uint i = 0; i < count; i++)
+    indices[base + i] = vertex_base + i;
