       dirty_state.set(DirtyState::RasterizerState);
@@ -5372,6 +5381,24 @@
       Desc.IndexBufferFormat = SM50_INDEX_BUFFER_FORMAT_NONE;
     }
     Desc.SampleCount = state_.OutputMerger.SampleCount;
+    // AnyOS: target-independent rasterization (D3D11.1): ForcedSampleCount
+    // N > 1 with a single-sample render target bound.  D3D rasterizes N
+    // samples and gives the pixel shader an N-bit SV_Coverage (Direct2D
+    // scales a stroke's alpha by its popcount / N); Metal rasterizes with the
+    // attachment's one sample, so the pixel shader reads (1 << N) - 1 instead
+    // and strokes keep their alpha (1/N of it otherwise).  Fragments are still
+    // generated at the pixel centre only: edges are not antialiased.
+    Desc.ForcedCoverageMask = 0;
+    if (Desc.PixelShader && Desc.SampleCount == 1) {
+      IMTLD3D11RasterizerState *rs =
+          state_.Rasterizer.RasterizerState ? state_.Rasterizer.RasterizerState : default_rasterizer_state;
+      uint32_t n = rs->TIRSampleCount();
+      bool rtv_bound = false;
+      for (unsigned i = 0; i < Desc.NumColorAttachments; i++)
+        rtv_bound |= Desc.ColorAttachmentFormats[i] != WMTPixelFormatInvalid;
+      if (n > 1 && rtv_bound)
+        Desc.ForcedCoverageMask = n >= 32 ? ~0u : (1u << n) - 1;
+    }
   }
 
