   }
   SM50_SHADER_METAL_VERSION metal_version = SM50_SHADER_METAL_310;
   SM50_SHADER_FLAG shader_flags = {};
@@ -299,6 +301,17 @@
       p(sig_ctx);
     }
   }
+  if (pso_forced_coverage_mask) {
+    // AnyOS: target-independent rasterization -- SV_Coverage reads the
+    // forced sample count's full mask instead of Metal's one-sample coverage
+    // (the signature handler above bound coverage_mask_arg to the
+    // [[sample_mask]] input; reads still AND it with pso_sample_mask).
+    prologue << make_effect([=](struct context ctx) {
+      if (ctx.resource.coverage_mask_arg)
+        ctx.resource.coverage_mask_arg = ctx.builder.getInt32(pso_forced_coverage_mask);
+      return std::monostate{};
+    });
+  }
   if (pso_sample_mask != 0xffffffff) {
     auto assigned_index =
       func_signature.DefineOutput(air::OutputCoverageMask{});
