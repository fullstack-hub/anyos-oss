+    caps->options10.MeshShaderPerPrimitiveShadingRateSupported = FALSE;
+    caps->options21.WorkGraphsTier = D3D12_WORK_GRAPHS_TIER_NOT_SUPPORTED;
+    /* ResourceBindingTier stays 3: direct heap indexing remains a mandatory
