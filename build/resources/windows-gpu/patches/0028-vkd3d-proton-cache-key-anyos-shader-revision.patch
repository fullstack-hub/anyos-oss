vkd3d-proton: the pipeline cache key carries an AnyOS shader revision

The disk cache (vkd3d-proton.cache next to the application) and serialized
pipeline libraries are keyed by the upstream build id, which our patches do
not change: after a tools update that fixed a shader compiler (dxil-spirv
0027), a guest kept loading the old, wrong SPIR-V.  The key now mixes in
VKD3D_ANYOS_SHADER_REVISION, bumped with every patch that changes compiled
shaders (1: dxil-spirv 0027).

diff --git a/libs/vkd3d/cache.c b/libs/vkd3d/cache.c
index 14a5755..1ff72b4 100644
--- a/libs/vkd3d/cache.c
+++ b/libs/vkd3d/cache.c
@@ -22,6 +22,13 @@
 #include "vkd3d_private.h"
 #include "vkd3d_shader.h"
 
+/* AnyOS: fixes in the shader compilers (dxil-spirv, vkd3d-shader) change the
+ * SPIR-V a cached pipeline holds without changing the upstream build id, so
+ * a guest kept the old, wrong code across a tools update. Bump this with
+ * every patch that changes compiled shaders. */
+#define VKD3D_ANYOS_SHADER_REVISION 1
+#define VKD3D_ANYOS_BUILD (vkd3d_build ^ (VKD3D_ANYOS_SHADER_REVISION * UINT64_C(0x9e3779b97f4a7c15)))
+
 struct vkd3d_cached_pipeline_key
 {
     size_t name_length;
@@ -381,15 +388,15 @@ HRESULT d3d12_cached_pipeline_state_validate(struct d3d12_device *device,
      * and the driver since that will affect the generated pipeline cache.
      * Based on global configuration flags, which extensions are available, etc,
      * the generated shaders may also change, so key on that as well. */
-    if (blob->vkd3d_build != vkd3d_build ||
+    if (blob->vkd3d_build != VKD3D_ANYOS_BUILD ||
             blob->vkd3d_shader_interface_key != device->shader_interface_key)
     {
         if (VKD3D_CONFIG_FLAG_IS_SET(PIPELINE_LIBRARY_LOG))
         {
-            if (blob->vkd3d_build != vkd3d_build)
+            if (blob->vkd3d_build != VKD3D_ANYOS_BUILD)
             {
                 INFO("Unexpected build version (got %"PRIx64", expected %"PRIx64"), returning D3D12_ERROR_DRIVER_VERSION_MISMATCH.\n",
-                        blob->vkd3d_build, vkd3d_build);
+                        blob->vkd3d_build, VKD3D_ANYOS_BUILD);
             }
 
             if (blob->vkd3d_shader_interface_key != device->shader_interface_key)
@@ -1224,7 +1231,7 @@ VkResult vkd3d_serialize_pipeline_state(struct d3d12_pipeline_library *pipeline_
         blob->vendor_id = device_properties->vendorID;
         blob->device_id = device_properties->deviceID;
         blob->vkd3d_shader_interface_key = state->device->shader_interface_key;
-        blob->vkd3d_build = vkd3d_build;
+        blob->vkd3d_build = VKD3D_ANYOS_BUILD;
 
         if (pipeline_library && (pipeline_library->flags & VKD3D_PIPELINE_LIBRARY_FLAG_SHADER_IDENTIFIER))
         {
@@ -1936,7 +1943,7 @@ static void d3d12_pipeline_library_serialize_stream_archive_header(struct d3d12_
     header->vendor_id = device_properties->vendorID;
     header->device_id = device_properties->deviceID;
     header->reserved = 0;
-    header->vkd3d_build = vkd3d_build;
+    header->vkd3d_build = VKD3D_ANYOS_BUILD;
     header->vkd3d_shader_interface_key = pipeline_library->device->shader_interface_key;
 
     if (pipeline_library->flags & VKD3D_PIPELINE_LIBRARY_FLAG_SHADER_IDENTIFIER)
@@ -2017,7 +2024,7 @@ static HRESULT d3d12_pipeline_library_serialize(struct d3d12_pipeline_library *p
     header->pipeline_count = pipeline_library->pso_map.used_count;
     header->spirv_count = pipeline_library->spirv_cache_map.used_count;
     header->driver_cache_count = pipeline_library->driver_cache_map.used_count;
-    header->vkd3d_build = vkd3d_build;
+    header->vkd3d_build = VKD3D_ANYOS_BUILD;
     header->vkd3d_shader_interface_key = pipeline_library->device->shader_interface_key;
 
     if (pipeline_library->flags & VKD3D_PIPELINE_LIBRARY_FLAG_SHADER_IDENTIFIER)
@@ -2223,7 +2230,7 @@ static HRESULT d3d12_pipeline_library_validate_stream_format_header(struct d3d12
     if (header->device_id != device_properties->deviceID || header->vendor_id != device_properties->vendorID)
         return D3D12_ERROR_ADAPTER_NOT_FOUND;
 
-    if (header->vkd3d_build != vkd3d_build)
+    if (header->vkd3d_build != VKD3D_ANYOS_BUILD)
         return D3D12_ERROR_DRIVER_VERSION_MISMATCH;
 
     if (header->vkd3d_shader_interface_key != device->shader_interface_key)
@@ -2405,7 +2412,7 @@ static HRESULT d3d12_pipeline_library_read_blob_toc_format(struct d3d12_pipeline
         return D3D12_ERROR_ADAPTER_NOT_FOUND;
     }
 
-    if (header->vkd3d_build != vkd3d_build)
+    if (header->vkd3d_build != VKD3D_ANYOS_BUILD)
     {
         if (VKD3D_CONFIG_FLAG_IS_SET(PIPELINE_LIBRARY_LOG))
             INFO("Rejecting pipeline library due to vkd3d-proton build mismatch.\n");
