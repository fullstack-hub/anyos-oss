--- a/virtgpu_vblank.c
+++ b/virtgpu_vblank.c
@@ -0,0 +1,398 @@
+// SPDX-License-Identifier: GPL-2.0 OR MIT
+/*
+ * Any OS: host-driven vblank (VIRTIO_GPU_F_ANYOS_VBLANK).
+ *
+ * The AnyOS engine's virtio-gpu offers feature bit 20 and a third virtqueue
+ * that completes one in-buffer per vblank of the Mac display the viewer
+ * window is on (QEMU patch 0052).  The stock driver has no vblank at all:
+ * the DRM core fakes every page-flip event at commit time, so Xorg's
+ * Present reports UST/MSC 0 and Mesa, mutter and every client pace
+ * themselves with timers that beat against the host's display link (a
+ * frame drawn twice and one skipped every few seconds at 120 Hz).
+ *
+ * With the feature negotiated this file gives every scanout a DRM vblank
+ * that is phase-locked to the host's display:
+ *
+ *  - A guest hrtimer is the tick.  It runs at the mode's period and fires
+ *    at the estimated instants of the host's vblanks, so ticks are regular
+ *    even when the events reach the guest late (QEMU delivers them under
+ *    its big lock; a main loop busy with GPU commands adds milliseconds).
+ *  - Each host event re-phases the timer.  Its host timestamp plus the
+ *    smallest delivery offset seen (tracked with a slow decay, snapped on a
+ *    clock jump) is the vblank's instant on the guest clock; the timer is
+ *    moved to one period past it.  The offset is measured on the raw
+ *    monotonic clock: the host stamps its vblanks with the Mac's raw uptime
+ *    clock, the counter the guest's raw clock also reads, whereas
+ *    CLOCK_MONOTONIC runs at NTP's frequency correction (timesyncd's was
+ *    +331 ppm, faster than the floor can follow).  An
+ *    event whose slot the timer already served is folded; one the timer
+ *    missed (first events, a late expiry) ticks at once.
+ *  - Without host events (no viewer window, the Mac's display asleep) the
+ *    timer free-runs at the mode's rate: nothing downstream ever waits
+ *    for the host.
+ *
+ * The timer runs only while the DRM core has vblank enabled (a flip or a
+ * wait in flight, plus its off-delay); while disabled the event buffers
+ * are held back, so the host drops its events and the guest sleeps.
+ */
+#include <linux/hrtimer.h>
+#include <linux/ktime.h>
+#include <linux/moduleparam.h>
+#include <linux/scatterlist.h>
+#include <linux/virtio.h>
+
+#include <drm/drm_vblank.h>
+
+#include "virtgpu_drv.h"
+
+/*
+ * virtio_gpu.anyos_vblank=0 turns the host-driven vblank off; off, the queue
+ * stays unused and the driver behaves like the stock one (page flips
+ * complete at commit time, Present's UST/MSC stay 0).  On by default since
+ * 2026-09-23: the GNOME Shell stalls (0.4-16 s) seen with three presenters
+ * were Mesa's DRI3 target-MSC arithmetic in the X11 compositor once MSC is
+ * real, not lost ticks -- ticks and flip events kept flowing while the
+ * compositor sent no frame; install.sh adds a drirc entry that turns
+ * vblank_mode off for gnome-shell only (the kernel still syncs its flips).
+ */
+static bool virtio_gpu_anyos_vblank_param = true;
+module_param_named(anyos_vblank, virtio_gpu_anyos_vblank_param, bool, 0444);
+MODULE_PARM_DESC(anyos_vblank,
+		 "Host-driven vblank from the Any OS engine (default: Y)");
+
+bool virtio_gpu_vblank_wanted(struct virtio_device *vdev)
+{
+	return virtio_gpu_anyos_vblank_param &&
+	       virtio_has_feature(vdev, VIRTIO_GPU_F_ANYOS_VBLANK);
+}
+
+/* Lock held. Marks the slot served; the caller delivers after unlocking. */
+static bool virtio_gpu_vblank_claim(struct virtio_gpu_vblank *vb, s64 slot_ns)
+{
+	if (vb->last_tick_ns && slot_ns - vb->last_tick_ns < vb->period_ns / 2) {
+		vb->coalesced++;
+		return false;
+	}
+	vb->last_tick_ns = slot_ns;
+	return true;
+}
+
+/* Every scanout ticks; the core drops ticks for CRTCs whose vblank is off. */
+static void virtio_gpu_vblank_deliver(struct virtio_gpu_device *vgdev)
+{
+	struct virtio_gpu_vblank *vb = &vgdev->vblank;
+	s64 now = ktime_get_ns();
+	int i;
+
+	/* Diagnostics: the longest silence between delivered ticks. */
+	if (vb->last_delivered_ns && now - vb->last_delivered_ns > vb->max_tick_gap_ns)
+		vb->max_tick_gap_ns = now - vb->last_delivered_ns;
+	vb->last_delivered_ns = now;
+	for (i = 0; i < vgdev->num_scanouts; i++)
+		drm_crtc_handle_vblank(&vgdev->outputs[i].crtc);
+}
+
+/* Lock held: (re)arm the timer for the slot in next_ns. */
+static void virtio_gpu_vblank_arm(struct virtio_gpu_vblank *vb)
+{
+	if (!vb->enabled || !vb->running)
+		return;
+	hrtimer_start(&vb->timer, ns_to_ktime(vb->next_ns), HRTIMER_MODE_ABS);
+}
+
+static enum hrtimer_restart virtio_gpu_vblank_expire(struct hrtimer *timer)
+{
+	struct virtio_gpu_device *vgdev =
+		container_of(timer, struct virtio_gpu_device, vblank.timer);
+	struct virtio_gpu_vblank *vb = &vgdev->vblank;
+	unsigned long flags;
+	bool tick = false;
+	s64 now;
+
+	spin_lock_irqsave(&vb->lock, flags);
+	if (vb->enabled && vb->running) {
+		now = ktime_get_ns();
+		/*
+		 * next_ns is the next unserved slot.  A host event that came
+		 * in while this expiry was pending has already moved it into
+		 * the future; then there is nothing to serve yet.
+		 */
+		if (now >= vb->next_ns - vb->period_ns / 8) {
+			tick = virtio_gpu_vblank_claim(vb, vb->next_ns);
+			if (tick)
+				vb->timer_ticks++;
+			/*
+			 * Phase-locked: the next slot follows the scheduled
+			 * one, not this expiry.  A slot missed by a whole
+			 * period (the CPU was away) is skipped, not bunched.
+			 */
+			vb->next_ns += vb->period_ns;
+			if (vb->next_ns <= now) {
+				vb->timer_late++;
+				vb->next_ns += ((now - vb->next_ns) / vb->period_ns + 1) *
+					       vb->period_ns;
+			}
+		} else {
+			vb->timer_early++;
+		}
+		virtio_gpu_vblank_arm(vb);
+	}
+	spin_unlock_irqrestore(&vb->lock, flags);
+	if (tick)
+		virtio_gpu_vblank_deliver(vgdev);
+	return HRTIMER_NORESTART;
+}
+
+/* Lock held. */
+static void virtio_gpu_vblank_post(struct virtio_gpu_vblank *vb,
+				   struct anyos_vblank_event *event)
+{
+	struct scatterlist sg;
+
+	sg_init_one(&sg, event, sizeof(*event));
+	if (virtqueue_add_inbuf(vb->vq, &sg, 1, event, GFP_ATOMIC))
+		vb->post_failures++;
+	else
+		vb->posted++;
+}
+
+/*
+ * Lock held: a host vblank with the given host timestamp reached the guest
+ * at `now` (CLOCK_MONOTONIC), `now_raw` on the raw clock.  Returns true
+ * when the guest must tick for it (its slot was not served by the timer).
+ */
+static bool virtio_gpu_vblank_host_event(struct virtio_gpu_vblank *vb,
+					 s64 host_ns, s64 now, s64 now_raw)
+{
+	s64 offset = now_raw - host_ns, slot_ns, error;
+
+	/*
+	 * The guest-minus-host clock offset: its floor is the smallest
+	 * delivery latency.  It follows a drop at once, creeps up by 1/4096
+	 * period per event (a permanently slower path: a 2 ms shift is
+	 * followed in ~8 s at 120 Hz), and snaps on a jump of over four
+	 * periods (a clock discontinuity, a long stall).
+	 */
+	if (!vb->offset_valid || offset < vb->offset_ns ||
+	    offset - vb->offset_ns > 4 * vb->period_ns) {
+		if (vb->offset_valid && offset > vb->offset_ns)
+			vb->offset_snaps++;
+		vb->offset_ns = offset;
+		vb->offset_valid = true;
+	} else {
+		vb->offset_ns += min(offset - vb->offset_ns, vb->period_ns / 4096);
+	}
+	/* The slot on the raw clock, then on CLOCK_MONOTONIC (the timer's). */
+	slot_ns = now - (now_raw - (host_ns + vb->offset_ns));
+	if (now - slot_ns > vb->max_delivery_ns)
+		vb->max_delivery_ns = now - slot_ns;
+	/* The timer's phase error against this vblank, before re-phasing. */
+	error = vb->next_ns - vb->period_ns - slot_ns;
+	if (error < 0)
+		error = -error;
+	if (error > vb->max_phase_error_ns)
+		vb->max_phase_error_ns = error;
+	vb->next_ns = slot_ns + vb->period_ns;
+	if (vb->next_ns <= now)
+		vb->next_ns += ((now - vb->next_ns) / vb->period_ns + 1) *
+			       vb->period_ns;
+	virtio_gpu_vblank_arm(vb);
+	if (virtio_gpu_vblank_claim(vb, slot_ns)) {
+		vb->host_ticks++;
+		return true;
+	}
+	vb->folded++;
+	return false;
+}
+
+/* Virtqueue callback: one completed in-buffer per host vblank. IRQ context. */
+void virtio_gpu_vblank_ack(struct virtqueue *vq)
+{
+	struct drm_device *dev = vq->vdev->priv;
+	struct virtio_gpu_device *vgdev = dev->dev_private;
+	struct virtio_gpu_vblank *vb = &vgdev->vblank;
+	struct anyos_vblank_event *event;
+	unsigned int len, ticks = 0;
+	unsigned long flags;
+	bool reposted = false;
+
+	spin_lock_irqsave(&vb->lock, flags);
+	while ((event = virtqueue_get_buf(vq, &len))) {
+		s64 now_raw = ktime_get_raw_ns(), now = ktime_get_ns();
+
+		vb->received++;
+		if (len >= sizeof(*event)) {
+			u32 interval_us = le32_to_cpu(event->interval_us);
+
+			if (interval_us >= 1000 && interval_us <= 100000)
+				vb->host_interval_ns = (s64)interval_us * NSEC_PER_USEC;
+			if (vb->running &&
+			    virtio_gpu_vblank_host_event(vb, le64_to_cpu(event->host_time_ns),
+							 now, now_raw))
+				ticks++;
+		} else {
+			vb->short_events++;
+		}
+		/* Held back while the core has vblank disabled (see enable). */
+		if (vb->running) {
+			virtio_gpu_vblank_post(vb, event);
+			reposted = true;
+		} else {
+			vb->held[vb->held_count++] = event;
+		}
+	}
+	if (reposted)
+		virtqueue_kick(vq);
+	spin_unlock_irqrestore(&vb->lock, flags);
+	while (ticks--)
+		virtio_gpu_vblank_deliver(vgdev);
+}
+
+/*
+ * A scanout's mode changed: the tick runs at the mode's refresh rate. The
+ * host's events re-phase it; their own interval is only reported.
+ */
+void virtio_gpu_vblank_set_mode(struct virtio_gpu_device *vgdev,
+				const struct drm_display_mode *mode)
+{
+	struct virtio_gpu_vblank *vb = &vgdev->vblank;
+	int vrefresh = mode ? drm_mode_vrefresh(mode) : 0;
+	unsigned long flags;
+
+	if (vrefresh < 10 || vrefresh > 1000)
+		vrefresh = 60;
+	spin_lock_irqsave(&vb->lock, flags);
+	vb->period_ns = NSEC_PER_SEC / vrefresh;
+	vb->offset_valid = false;
+	if (vb->running) {
+		vb->next_ns = ktime_get_ns() + vb->period_ns;
+		virtio_gpu_vblank_arm(vb);
+	}
+	spin_unlock_irqrestore(&vb->lock, flags);
+}
+
+/* drm_crtc_funcs.enable_vblank: the core wants ticks (a flip or a wait). */
+int virtio_gpu_vblank_enable(struct drm_crtc *crtc)
+{
+	struct virtio_gpu_device *vgdev = crtc->dev->dev_private;
+	struct virtio_gpu_vblank *vb = &vgdev->vblank;
+	unsigned long flags;
+
+	if (!vb->enabled)
+		return -EINVAL;
+	spin_lock_irqsave(&vb->lock, flags);
+	vb->running_crtcs |= BIT(drm_crtc_index(crtc));
+	if (!vb->running) {
+		vb->running = true;
+		vb->offset_valid = false;
+		vb->last_tick_ns = 0;
+		vb->last_delivered_ns = 0;
+		vb->next_ns = ktime_get_ns() + vb->period_ns;
+		while (vb->held_count)
+			virtio_gpu_vblank_post(vb, vb->held[--vb->held_count]);
+		virtqueue_kick(vb->vq);
+		virtio_gpu_vblank_arm(vb);
+		vb->enables++;
+	}
+	spin_unlock_irqrestore(&vb->lock, flags);
+	return 0;
+}
+
+/* drm_crtc_funcs.disable_vblank (vblank_time_lock held, IRQs off). */
+void virtio_gpu_vblank_disable(struct drm_crtc *crtc)
+{
+	struct virtio_gpu_device *vgdev = crtc->dev->dev_private;
+	struct virtio_gpu_vblank *vb = &vgdev->vblank;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vb->lock, flags);
+	/*
+	 * One timer ticks every CRTC: it stops only when no CRTC wants
+	 * vblanks, or a head with a flip in flight would never see its event.
+	 */
+	vb->running_crtcs &= ~BIT(drm_crtc_index(crtc));
+	if (vb->running && !vb->running_crtcs) {
+		vb->running = false;
+		/* Non-blocking; a running expiry sees running == false. */
+		hrtimer_try_to_cancel(&vb->timer);
+	}
+	spin_unlock_irqrestore(&vb->lock, flags);
+}
+
+/*
+ * Called from virtio_gpu_init once the queues are found and the CRTCs exist,
+ * before drm_dev_register: registers DRM vblank support for every scanout
+ * and posts the event buffers.
+ */
+int virtio_gpu_vblank_init(struct virtio_gpu_device *vgdev,
+			   struct virtqueue *vq)
+{
+	struct virtio_gpu_vblank *vb = &vgdev->vblank;
+	int i, ret;
+
+	if (!vgdev->num_scanouts)
+		return 0;
+	/*
+	 * The lock and the timer first: once events is set, every failure
+	 * below reaches virtio_gpu_vblank_fini, which cancels the timer.
+	 */
+	spin_lock_init(&vb->lock);
+	hrtimer_init(&vb->timer, CLOCK_MONOTONIC, HRTIMER_MODE_ABS);
+	vb->timer.function = virtio_gpu_vblank_expire;
+	vb->events = kcalloc(VIRTIO_GPU_ANYOS_VBLANK_BUFFERS,
+			     sizeof(*vb->events), GFP_KERNEL);
+	if (!vb->events)
+		return -ENOMEM;
+	ret = drm_vblank_init(vgdev->ddev, vgdev->num_scanouts);
+	if (ret)
+		return ret;
+	vb->vq = vq;
+	vb->period_ns = NSEC_PER_SEC / 60;
+	spin_lock_irq(&vb->lock);
+	for (i = 0; i < VIRTIO_GPU_ANYOS_VBLANK_BUFFERS; i++)
+		virtio_gpu_vblank_post(vb, &vb->events[i]);
+	vb->enabled = true;
+	spin_unlock_irq(&vb->lock);
+	DRM_INFO("anyos vblank: host-driven vblank on %d scanout(s)\n",
+		 vgdev->num_scanouts);
+	return 0;
+}
+
+/* After virtio_device_ready: let the device see the posted buffers. */
+void virtio_gpu_vblank_start(struct virtio_gpu_device *vgdev)
+{
+	struct virtio_gpu_vblank *vb = &vgdev->vblank;
+
+	if (!vb->enabled)
+		return;
+	spin_lock_irq(&vb->lock);
+	virtqueue_kick(vb->vq);
+	spin_unlock_irq(&vb->lock);
+}
+
+/* Before the device is reset and its queues deleted. */
+void virtio_gpu_vblank_stop(struct virtio_gpu_device *vgdev)
+{
+	struct virtio_gpu_vblank *vb = &vgdev->vblank;
+
+	if (!vb->enabled)
+		return;
+	spin_lock_irq(&vb->lock);
+	vb->enabled = false;
+	vb->running = false;
+	vb->running_crtcs = 0;
+	spin_unlock_irq(&vb->lock);
+	hrtimer_cancel(&vb->timer);
+}
+
+/* After del_vqs: nothing references the event buffers any more. */
+void virtio_gpu_vblank_fini(struct virtio_gpu_device *vgdev)
+{
+	struct virtio_gpu_vblank *vb = &vgdev->vblank;
+
+	if (vb->events)
+		hrtimer_cancel(&vb->timer);
+	kfree(vb->events);
+	vb->events = NULL;
+	vb->vq = NULL;
+}
